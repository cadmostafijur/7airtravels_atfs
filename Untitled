# Copy to .env and fill in values. Never commit real credentials.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=7 Air Travels ATFS
NEXT_PUBLIC_APP_TIMEZONE=Asia/Dhaka
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# PostgreSQL
DATABASE_URL=postgresql://neondb_owner:npg_tr0aoLj4FsxZ@ep-fancy-block-axo38kq4-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Session (generate a long random string)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Bootstrap admin created by prisma seed
ADMIN_BOOTSTRAP_EMAIL=admin@7airtravels.local
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe_Admin1!
ADMIN_BOOTSTRAP_NAME=System Administrator

# K50A — TCP/IP on the office LAN. Do not expose this port to the public internet.
K50A_IP=192.168.1.201
K50A_PORT=4370
K50A_TIMEOUT_MS=10000
K50A_COMM_KEY=0
K50A_LOCATION=Main Office

# Device adapter: k50a | mock
DEVICE_ADAPTER=mock

# Simulation mode is blocked in production unless ALLOW_SIMULATION_IN_PRODUCTION=true
SIMULATION_MODE=true
ALLOW_SIMULATION_IN_PRODUCTION=false

# Background worker
WORKER_PORT=3001
WORKER_INTERNAL_SECRET=replace-with-another-long-random-secret
SYNC_INTERVAL_MS=30000
ENABLE_REALTIME_DEVICE_EVENTS=false

# SMS — provider-independent. Use console in development.
# Providers: console | http | failing
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=7AIR
SMS_API_METHOD=POST
# Optional JSON body template. Tokens: {{phone}} {{message}} {{sender}} {{apiKey}}
SMS_HTTP_BODY_TEMPLATE=
SMS_HTTP_PHONE_PARAM=number
SMS_HTTP_MESSAGE_PARAM=message
SMS_RETRY_FAILED=true

# Three administrator SMS numbers (Bangladesh local or E.164)
ADMIN_SMS_1=
ADMIN_SMS_2=
ADMIN_SMS_3=

# Timezone used for attendance rules
APP_TIMEZONE=Asia/Dhaka
